   "source": [
    "i=1\n",
    "while i<=30:\n",
    "    c=0\n",
    "    for j in range(1,i+1):\n",
    "        if i%j==0:\n",
    "            c=c+1\n",
    "    if c==2:\n",
    "        print(i,\" is a prime number\")\n",
    "    i+=1"
   ]
  }
