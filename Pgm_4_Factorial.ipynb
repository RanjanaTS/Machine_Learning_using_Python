   "source": [
    "n=int(input(\"enter a no. : \"))\n",
    "def fact(n):\n",
    "    if n==0 or n==1:\n",
    "        return 1\n",
    "    return n*fact(n-1)\n",
    "print(fact(n))"
   ]
